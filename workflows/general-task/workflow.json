{
  "schema_version": 2,
  "key": "general-task",
  "labels": {
    "zh-CN": "通用任务",
    "en": "General task"
  },
  "short_descriptions": {
    "zh-CN": "由负责人、执行者和评审者协作完成一般性任务。",
    "en": "Coordinate general work with an owner, executors, and reviewers."
  },
  "coordinator_role": "owner",
  "roles": [
    {
      "key": "owner",
      "labels": {
        "zh-CN": "负责人",
        "en": "Owner"
      },
      "descriptions": {
        "zh-CN": "负责目标、范围、优先级、任务路由、最终验收和外部决策沟通。",
        "en": "Owns goals, scope, priority, task routing, final acceptance, and external decisions."
      },
      "allow_multiple": false
    },
    {
      "key": "executor",
      "labels": {
        "zh-CN": "执行者",
        "en": "Executor"
      },
      "descriptions": {
        "zh-CN": "负责认领任务、完成工作、报告进展并提交结果与证据。",
        "en": "Claims tasks, performs the work, reports progress, and submits results with evidence."
      },
      "allow_multiple": true
    },
    {
      "key": "reviewer",
      "labels": {
        "zh-CN": "评审者",
        "en": "Reviewer"
      },
      "descriptions": {
        "zh-CN": "负责独立检查结果、识别风险并提交评审证据。",
        "en": "Independently checks results, identifies risks, and submits review evidence."
      },
      "allow_multiple": true
    }
  ],
  "task_types": [
    {
      "key": "task",
      "labels": {
        "zh-CN": "任务",
        "en": "Task"
      },
      "descriptions": {
        "zh-CN": "完成一个边界和验收标准明确的普通任务。",
        "en": "Completes a general task with clear boundaries and acceptance criteria."
      },
      "default_role": "executor"
    },
    {
      "key": "research",
      "labels": {
        "zh-CN": "调研",
        "en": "Research"
      },
      "descriptions": {
        "zh-CN": "收集证据、比较选项并形成可复查结论。",
        "en": "Collects evidence, compares options, and produces a reviewable conclusion."
      },
      "default_role": "executor"
    },
    {
      "key": "content",
      "labels": {
        "zh-CN": "内容",
        "en": "Content"
      },
      "descriptions": {
        "zh-CN": "撰写、整理或更新文档及其他内容产物。",
        "en": "Writes, organizes, or updates documents and other content deliverables."
      },
      "default_role": "executor"
    },
    {
      "key": "decision",
      "labels": {
        "zh-CN": "决策",
        "en": "Decision"
      },
      "descriptions": {
        "zh-CN": "比较方案、记录取舍并形成明确决定。",
        "en": "Compares alternatives, records tradeoffs, and produces a clear decision."
      },
      "default_role": "owner"
    },
    {
      "key": "review",
      "labels": {
        "zh-CN": "评审",
        "en": "Review"
      },
      "descriptions": {
        "zh-CN": "独立检查已有产物并形成评审结论。",
        "en": "Independently checks an existing deliverable and produces a review conclusion."
      },
      "default_role": "reviewer"
    },
    {
      "key": "chore",
      "labels": {
        "zh-CN": "事务",
        "en": "Chore"
      },
      "descriptions": {
        "zh-CN": "处理配置、维护、整理和其他日常事务。",
        "en": "Handles configuration, maintenance, organization, and other routine work."
      },
      "default_role": "executor"
    }
  ],
  "waiting_targets": [
    {
      "key": "owner",
      "labels": {
        "zh-CN": "负责人",
        "en": "Owner"
      },
      "color": {
        "hue": "Blue",
        "lightness": "Lighter"
      }
    },
    {
      "key": "stakeholder",
      "labels": {
        "zh-CN": "外部决策人",
        "en": "Stakeholder"
      },
      "color": {
        "hue": "Purple",
        "lightness": "Lighter"
      }
    }
  ],
  "task_schema": {
    "base": "teamflow-task-v1",
    "task_id": {
      "sequence_length": 4
    }
  },
  "lifecycle": {
    "initial_state": "backlog",
    "terminal_states": [
      "done",
      "canceled"
    ],
    "states": [
      {
        "key": "backlog",
        "labels": {
          "zh-CN": "待规划",
          "en": "Backlog"
        },
        "color": {
          "hue": "Gray",
          "lightness": "Lighter"
        },
        "dispatch": "none",
        "required_fields": [
          "title"
        ]
      },
      {
        "key": "ready",
        "labels": {
          "zh-CN": "可执行",
          "en": "Ready"
        },
        "color": {
          "hue": "Blue",
          "lightness": "Lighter"
        },
        "dispatch": "task_role",
        "dispatch_instructions": {
          "zh-CN": "这是一项等待认领的任务。请读取完整卡片并判断是否接手；仅在决定执行后通过 TeamFlow 工具认领。",
          "en": "This task is ready to be claimed. Read the complete task and claim it through TeamFlow only after deciding to execute it."
        },
        "required_fields": [
          "title",
          "type",
          "priority",
          "role",
          "description",
          "acceptance_criteria"
        ]
      },
      {
        "key": "in_progress",
        "labels": {
          "zh-CN": "进行中",
          "en": "In Progress"
        },
        "color": {
          "hue": "Orange",
          "lightness": "Light"
        },
        "dispatch": "none",
        "required_fields": [
          "title",
          "type",
          "priority",
          "role",
          "description",
          "acceptance_criteria",
          "agent",
          "agent_id"
        ]
      },
      {
        "key": "review",
        "labels": {
          "zh-CN": "待评审",
          "en": "Review"
        },
        "color": {
          "hue": "Purple",
          "lightness": "Lighter"
        },
        "dispatch": "coordinator",
        "dispatch_instructions": {
          "zh-CN": "该任务已进入待评审。请读取结果与证据，并由负责人决定通过、返工或转交独立评审。",
          "en": "This task is ready for review. Read its result and evidence, then decide whether to approve, rework, or request an independent review."
        },
        "required_fields": [
          "title",
          "type",
          "priority",
          "role",
          "description",
          "acceptance_criteria",
          "result_evidence"
        ]
      },
      {
        "key": "blocked",
        "labels": {
          "zh-CN": "已阻塞",
          "en": "Blocked"
        },
        "color": {
          "hue": "Red",
          "lightness": "Lighter"
        },
        "dispatch": "coordinator",
        "dispatch_instructions": {
          "zh-CN": "该任务已阻塞。请读取阻塞原因、等待对象和下一步，并由负责人协调处理。",
          "en": "This task is blocked. Read the reason, waiting target, and next action, then coordinate the resolution as the owner."
        },
        "required_fields": [
          "title",
          "role",
          "blocked_reason",
          "waiting_on",
          "next_action"
        ]
      },
      {
        "key": "done",
        "labels": {
          "zh-CN": "已完成",
          "en": "Done"
        },
        "color": {
          "hue": "Green",
          "lightness": "Light"
        },
        "dispatch": "none",
        "required_fields": [
          "title",
          "result_evidence"
        ]
      },
      {
        "key": "canceled",
        "labels": {
          "zh-CN": "已取消",
          "en": "Canceled"
        },
        "color": {
          "hue": "Gray",
          "lightness": "Standard"
        },
        "dispatch": "none",
        "required_fields": [
          "title",
          "result_evidence"
        ]
      }
    ],
    "actions": {
      "create": {
        "labels": {
          "zh-CN": "创建任务",
          "en": "Create task"
        },
        "rules": [
          {
            "key": "create",
            "labels": {
              "zh-CN": "创建待规划任务",
              "en": "Create backlog task"
            },
            "actors": [
              "coordinator"
            ],
            "to": "backlog",
            "writable_fields": [
              "title",
              "type",
              "priority",
              "role",
              "description",
              "context",
              "acceptance_criteria",
              "dependencies"
            ],
            "required_inputs": [
              "title"
            ],
            "defaults": {
              "priority": "P2"
            }
          }
        ]
      },
      "update": {
        "labels": {
          "zh-CN": "更新任务",
          "en": "Update task"
        },
        "rules": [
          {
            "key": "coordinate",
            "labels": {
              "zh-CN": "负责人更新",
              "en": "Owner update"
            },
            "actors": [
              "coordinator"
            ],
            "from": [
              "backlog",
              "ready",
              "in_progress",
              "review"
            ],
            "writable_fields": [
              "title",
              "type",
              "priority",
              "description",
              "context",
              "acceptance_criteria",
              "dependencies",
              "progress",
              "next_action",
              "result_evidence"
            ]
          },
          {
            "key": "coordinate_blocked",
            "labels": {
              "zh-CN": "阻塞态负责人更新",
              "en": "Blocked task owner update"
            },
            "actors": [
              "coordinator"
            ],
            "from": [
              "blocked"
            ],
            "writable_fields": [
              "title",
              "type",
              "priority",
              "description",
              "context",
              "acceptance_criteria",
              "dependencies",
              "progress",
              "next_action",
              "result_evidence",
              "blocked_reason",
              "waiting_on"
            ]
          },
          {
            "key": "execute",
            "labels": {
              "zh-CN": "执行更新",
              "en": "Executor update"
            },
            "actors": [
              "assigned_agent"
            ],
            "from": [
              "in_progress"
            ],
            "writable_fields": [
              "context",
              "progress",
              "next_action",
              "result_evidence"
            ]
          }
        ]
      },
      "route": {
        "labels": {
          "zh-CN": "路由任务",
          "en": "Route task"
        },
        "rules": [
          {
            "key": "prepare",
            "labels": {
              "zh-CN": "准备完成",
              "en": "Ready for execution"
            },
            "actors": [
              "coordinator"
            ],
            "from": [
              "backlog"
            ],
            "to": "ready",
            "writable_fields": [
              "role"
            ],
            "required_inputs": [
              "role"
            ],
            "clear_fields": [
              "agent",
              "agent_id",
              "blocked_reason",
              "waiting_on"
            ]
          },
          {
            "key": "resume",
            "labels": {
              "zh-CN": "解除阻塞",
              "en": "Resume after blocking"
            },
            "actors": [
              "coordinator"
            ],
            "from": [
              "blocked"
            ],
            "to": "ready",
            "writable_fields": [
              "role"
            ],
            "required_inputs": [
              "role"
            ],
            "clear_fields": [
              "agent",
              "agent_id",
              "blocked_reason",
              "waiting_on"
            ]
          },
          {
            "key": "recover",
            "labels": {
              "zh-CN": "恢复入队",
              "en": "Recover to ready"
            },
            "actors": [
              "coordinator"
            ],
            "from": [
              "in_progress"
            ],
            "to": "ready",
            "writable_fields": [
              "role"
            ],
            "required_inputs": [
              "role"
            ],
            "clear_fields": [
              "agent",
              "agent_id"
            ],
            "guards": [
              "executor_unavailable"
            ]
          }
        ]
      },
      "claim": {
        "labels": {
          "zh-CN": "认领任务",
          "en": "Claim task"
        },
        "rules": [
          {
            "key": "claim",
            "labels": {
              "zh-CN": "认领执行",
              "en": "Claim for execution"
            },
            "actors": [
              "task_role"
            ],
            "from": [
              "ready"
            ],
            "to": "in_progress",
            "required_task_fields": [
              "type",
              "priority",
              "role",
              "description",
              "acceptance_criteria"
            ],
            "actor_fields": {
              "agent": "agent_name",
              "agent_id": "agent_id"
            }
          }
        ]
      },
      "submit": {
        "labels": {
          "zh-CN": "提交结果",
          "en": "Submit result"
        },
        "rules": [
          {
            "key": "completed",
            "labels": {
              "zh-CN": "工作已完成",
              "en": "Work completed"
            },
            "actors": [
              "assigned_agent"
            ],
            "roles": [
              "owner",
              "executor"
            ],
            "from": [
              "in_progress"
            ],
            "to": "review",
            "writable_fields": [
              "progress",
              "next_action",
              "result_evidence"
            ],
            "required_inputs": [
              "result_evidence"
            ],
            "required_task_fields": [
              "result_evidence"
            ]
          },
          {
            "key": "reviewed",
            "labels": {
              "zh-CN": "评审完成",
              "en": "Review completed"
            },
            "actors": [
              "assigned_agent"
            ],
            "roles": [
              "reviewer"
            ],
            "from": [
              "in_progress"
            ],
            "to": "review",
            "writable_fields": [
              "progress",
              "next_action",
              "result_evidence"
            ],
            "required_inputs": [
              "result_evidence"
            ],
            "required_task_fields": [
              "result_evidence"
            ],
            "field_prefixes": {
              "result_evidence": "评审结论：已审阅（Reviewed）\n"
            }
          }
        ]
      },
      "block": {
        "labels": {
          "zh-CN": "阻塞任务",
          "en": "Block task"
        },
        "rules": [
          {
            "key": "ready_worker",
            "labels": {
              "zh-CN": "执行前发现阻塞",
              "en": "Blocked before execution"
            },
            "actors": [
              "task_role"
            ],
            "roles": [
              "executor",
              "reviewer"
            ],
            "from": [
              "ready"
            ],
            "to": "blocked",
            "writable_fields": [
              "progress",
              "next_action",
              "blocked_reason",
              "waiting_on"
            ],
            "required_inputs": [
              "next_action",
              "blocked_reason",
              "waiting_on"
            ],
            "field_values": {
              "waiting_on": [
                "owner"
              ]
            }
          },
          {
            "key": "ready_owner",
            "labels": {
              "zh-CN": "执行前等待外部决策",
              "en": "Await stakeholder before execution"
            },
            "actors": [
              "coordinator"
            ],
            "from": [
              "ready"
            ],
            "to": "blocked",
            "writable_fields": [
              "progress",
              "next_action",
              "blocked_reason",
              "waiting_on"
            ],
            "required_inputs": [
              "next_action",
              "blocked_reason",
              "waiting_on"
            ],
            "field_values": {
              "waiting_on": [
                "stakeholder"
              ]
            }
          },
          {
            "key": "worker",
            "labels": {
              "zh-CN": "执行中等待负责人",
              "en": "Worker waiting on owner"
            },
            "actors": [
              "assigned_agent"
            ],
            "roles": [
              "executor",
              "reviewer"
            ],
            "from": [
              "in_progress"
            ],
            "to": "blocked",
            "writable_fields": [
              "progress",
              "next_action",
              "blocked_reason",
              "waiting_on"
            ],
            "required_inputs": [
              "next_action",
              "blocked_reason",
              "waiting_on"
            ],
            "field_values": {
              "waiting_on": [
                "owner"
              ]
            }
          },
          {
            "key": "owner",
            "labels": {
              "zh-CN": "等待外部决策人",
              "en": "Waiting on stakeholder"
            },
            "actors": [
              "coordinator"
            ],
            "roles": [
              "owner"
            ],
            "from": [
              "in_progress",
              "review"
            ],
            "to": "blocked",
            "writable_fields": [
              "progress",
              "next_action",
              "blocked_reason",
              "waiting_on"
            ],
            "required_inputs": [
              "next_action",
              "blocked_reason",
              "waiting_on"
            ],
            "field_values": {
              "waiting_on": [
                "stakeholder"
              ]
            }
          }
        ]
      },
      "review": {
        "labels": {
          "zh-CN": "评审任务",
          "en": "Review task"
        },
        "rules": [
          {
            "key": "approve",
            "labels": {
              "zh-CN": "验收通过",
              "en": "Approve"
            },
            "actors": [
              "coordinator"
            ],
            "from": [
              "review"
            ],
            "to": "done",
            "writable_fields": [
              "result_evidence"
            ],
            "required_inputs": [
              "result_evidence"
            ],
            "required_task_fields": [
              "result_evidence"
            ]
          },
          {
            "key": "rework",
            "labels": {
              "zh-CN": "打回返工",
              "en": "Return for rework"
            },
            "actors": [
              "coordinator"
            ],
            "from": [
              "review"
            ],
            "to": "ready",
            "writable_fields": [
              "role",
              "next_action",
              "result_evidence"
            ],
            "required_inputs": [
              "role",
              "result_evidence"
            ],
            "required_task_fields": [
              "result_evidence"
            ],
            "clear_fields": [
              "agent",
              "agent_id"
            ]
          },
          {
            "key": "send_to_reviewer",
            "labels": {
              "zh-CN": "转交评审者",
              "en": "Send to reviewer"
            },
            "actors": [
              "coordinator"
            ],
            "from": [
              "review"
            ],
            "to": "ready",
            "writable_fields": [
              "next_action",
              "result_evidence"
            ],
            "required_inputs": [
              "result_evidence"
            ],
            "required_task_fields": [
              "result_evidence"
            ],
            "fixed_fields": {
              "role": "reviewer"
            },
            "clear_fields": [
              "agent",
              "agent_id"
            ]
          }
        ]
      },
      "cancel": {
        "labels": {
          "zh-CN": "取消任务",
          "en": "Cancel task"
        },
        "confirmation_required": true,
        "rules": [
          {
            "key": "cancel",
            "labels": {
              "zh-CN": "确认取消",
              "en": "Confirm cancellation"
            },
            "actors": [
              "coordinator"
            ],
            "from": [
              "backlog",
              "ready",
              "review",
              "blocked"
            ],
            "to": "canceled",
            "writable_fields": [
              "result_evidence"
            ],
            "required_inputs": [
              "result_evidence"
            ],
            "required_task_fields": [
              "result_evidence"
            ],
            "clear_fields": [
              "blocked_reason",
              "waiting_on",
              "next_action"
            ]
          },
          {
            "key": "cancel_in_progress",
            "labels": {
              "zh-CN": "停止执行后取消",
              "en": "Cancel after execution stops"
            },
            "actors": [
              "coordinator"
            ],
            "from": [
              "in_progress"
            ],
            "to": "canceled",
            "writable_fields": [
              "result_evidence"
            ],
            "required_inputs": [
              "result_evidence"
            ],
            "required_task_fields": [
              "result_evidence"
            ],
            "clear_fields": [
              "blocked_reason",
              "waiting_on",
              "next_action"
            ],
            "guards": [
              "execution_stopped"
            ]
          }
        ]
      }
    }
  },
  "runtime_actions": {
    "stop_execution": {
      "labels": {
        "zh-CN": "停止执行",
        "en": "Stop execution"
      },
      "actors": [
        "coordinator"
      ],
      "states": [
        "in_progress"
      ],
      "required_inputs": [
        "reason"
      ],
      "required_task_fields": [
        "agent_id"
      ],
      "confirmation_required": true,
      "produces": [
        "execution_stopped"
      ]
    }
  }
}
