{
  "schema_version": 3,
  "key": "software-development",
  "labels": {
    "zh-CN": "软件开发",
    "en": "Software development"
  },
  "short_descriptions": {
    "zh-CN": "由 PM、技术负责人、QA 和设计共同完成规划、实现、评审与验证。",
    "en": "Plan, build, review, and verify software work with PM, Technical Lead, QA, and Design."
  },
  "coordinator_role": "pm",
  "roles": [
    {
      "key": "pm",
      "labels": {
        "zh-CN": "PM",
        "en": "PM"
      },
      "descriptions": {
        "zh-CN": "负责范围、优先级、验收标准、任务路由、最终评审和项目决策人沟通。",
        "en": "Owns scope, priority, acceptance criteria, task routing, final review, and stakeholder alignment."
      },
      "allow_multiple": false
    },
    {
      "key": "tl",
      "labels": {
        "zh-CN": "技术负责人",
        "en": "Technical Lead"
      },
      "descriptions": {
        "zh-CN": "负责技术方案、任务拆解、实现、代码质量和技术风险。",
        "en": "Owns technical design, task breakdown, implementation, code quality, and technical risk."
      },
      "allow_multiple": true
    },
    {
      "key": "qa",
      "labels": {
        "zh-CN": "QA",
        "en": "QA"
      },
      "descriptions": {
        "zh-CN": "负责行为验证、回归检查、测试证据和缺陷反馈。",
        "en": "Owns behavior verification, regression checks, test evidence, and defect feedback."
      },
      "allow_multiple": true
    },
    {
      "key": "design",
      "labels": {
        "zh-CN": "设计",
        "en": "Design"
      },
      "descriptions": {
        "zh-CN": "负责产品交互、视觉设计、用户体验和用户文案。",
        "en": "Owns product interaction, visual design, user experience, and user-facing copy."
      },
      "allow_multiple": true
    }
  ],
  "task_types": [
    {
      "key": "requirement",
      "labels": {
        "zh-CN": "需求",
        "en": "Requirement"
      },
      "descriptions": {
        "zh-CN": "澄清问题、范围、目标和验收标准。",
        "en": "Clarifies the problem, scope, goals, and acceptance criteria."
      },
      "default_role": "pm"
    },
    {
      "key": "decision",
      "labels": {
        "zh-CN": "决策",
        "en": "Decision"
      },
      "descriptions": {
        "zh-CN": "比较选项、记录取舍并形成明确结论。",
        "en": "Compares options, records tradeoffs, and produces a clear decision."
      },
      "default_role": "pm"
    },
    {
      "key": "design",
      "labels": {
        "zh-CN": "设计",
        "en": "Design"
      },
      "descriptions": {
        "zh-CN": "产出用户体验、界面、视觉、交互或用户文案。",
        "en": "Produces user experience, interface, visual, interaction, or user-copy work."
      },
      "default_role": "design"
    },
    {
      "key": "development",
      "labels": {
        "zh-CN": "开发",
        "en": "Development"
      },
      "descriptions": {
        "zh-CN": "完成实现、重构或技术改造。",
        "en": "Implements, refactors, or performs technical changes."
      },
      "default_role": "tl"
    },
    {
      "key": "bug",
      "labels": {
        "zh-CN": "缺陷",
        "en": "Bug"
      },
      "descriptions": {
        "zh-CN": "完成缺陷复现、定位、修复和回归准备。",
        "en": "Reproduces, diagnoses, fixes, and prepares defects for regression testing."
      },
      "default_role": "tl"
    },
    {
      "key": "validation",
      "labels": {
        "zh-CN": "验证",
        "en": "Validation"
      },
      "descriptions": {
        "zh-CN": "执行测试、验证、回归和发布检查。",
        "en": "Performs testing, validation, regression, and release checks."
      },
      "default_role": "qa"
    },
    {
      "key": "chore",
      "labels": {
        "zh-CN": "工程事务",
        "en": "Chore"
      },
      "descriptions": {
        "zh-CN": "处理配置、构建、文档和工程维护。",
        "en": "Handles configuration, build work, documentation, and engineering maintenance."
      },
      "default_role": "tl"
    }
  ],
  "waiting_targets": [
    {
      "key": "pm",
      "labels": {
        "zh-CN": "PM",
        "en": "PM"
      },
      "color": {
        "hue": "Blue",
        "lightness": "Lighter"
      }
    },
    {
      "key": "stakeholder",
      "labels": {
        "zh-CN": "项目决策人",
        "en": "Stakeholder"
      },
      "color": {
        "hue": "Purple",
        "lightness": "Lighter"
      }
    }
  ],
  "task_schema": {
    "base": "teamflow-task-v1",
    "task_id": {
      "sequence_length": 4
    }
  },
  "lifecycle": {
    "initial_state": "backlog",
    "terminal_states": [
      "done",
      "canceled"
    ],
    "completion_states": [
      "done"
    ],
    "states": [
      {
        "key": "backlog",
        "labels": {
          "zh-CN": "待规划",
          "en": "Backlog"
        },
        "color": {
          "hue": "Gray",
          "lightness": "Lighter"
        },
        "dispatch": "none",
        "required_fields": [
          "title"
        ]
      },
      {
        "key": "ready",
        "labels": {
          "zh-CN": "可执行",
          "en": "Ready"
        },
        "color": {
          "hue": "Blue",
          "lightness": "Lighter"
        },
        "dispatch": "task_role",
        "dispatch_instructions": {
          "zh-CN": "这是一项等待认领的可执行任务。请读取完整卡片并判断是否接手；仅在决定执行后通过 TeamFlow 工具认领，收到通知本身不代表已经认领。",
          "en": "This task is ready to be claimed. Read the complete task before deciding whether to claim it through TeamFlow; receiving this notification does not claim the task."
        },
        "required_fields": [
          "title",
          "type",
          "priority",
          "role",
          "description",
          "acceptance_criteria"
        ]
      },
      {
        "key": "in_progress",
        "labels": {
          "zh-CN": "进行中",
          "en": "In Progress"
        },
        "color": {
          "hue": "Orange",
          "lightness": "Light"
        },
        "dispatch": "none",
        "required_fields": [
          "title",
          "type",
          "priority",
          "role",
          "description",
          "acceptance_criteria",
          "agent",
          "agent_id"
        ]
      },
      {
        "key": "review",
        "labels": {
          "zh-CN": "待评审",
          "en": "Review"
        },
        "color": {
          "hue": "Purple",
          "lightness": "Lighter"
        },
        "dispatch": "coordinator",
        "dispatch_instructions": {
          "zh-CN": "该任务已进入待评审。请读取结果与证据，按照当前协作模式中协调负责人的权限完成评审并决定下一步。",
          "en": "This task is ready for review. Read its result and evidence, then apply a review decision permitted for the workflow coordinator."
        },
        "required_fields": [
          "title",
          "type",
          "priority",
          "role",
          "description",
          "acceptance_criteria",
          "result_evidence"
        ]
      },
      {
        "key": "blocked",
        "labels": {
          "zh-CN": "已阻塞",
          "en": "Blocked"
        },
        "color": {
          "hue": "Red",
          "lightness": "Lighter"
        },
        "dispatch": "coordinator",
        "dispatch_instructions": {
          "zh-CN": "该任务刚进入已阻塞。请读取阻塞原因、等待对象和下一步，按照当前协作模式中协调负责人的权限处理本次阻塞。",
          "en": "This task is blocked. Read the blocking reason, waiting target, and next action, then handle it within the workflow coordinator's permissions."
        },
        "required_fields": [
          "title",
          "role",
          "blocked_reason",
          "waiting_on",
          "next_action"
        ]
      },
      {
        "key": "done",
        "labels": {
          "zh-CN": "已完成",
          "en": "Done"
        },
        "color": {
          "hue": "Green",
          "lightness": "Light"
        },
        "dispatch": "none",
        "required_fields": [
          "title",
          "result_evidence"
        ]
      },
      {
        "key": "canceled",
        "labels": {
          "zh-CN": "已取消",
          "en": "Canceled"
        },
        "color": {
          "hue": "Gray",
          "lightness": "Standard"
        },
        "dispatch": "none",
        "required_fields": [
          "title",
          "result_evidence"
        ]
      }
    ],
    "actions": {
      "create": {
        "labels": {
          "zh-CN": "创建任务",
          "en": "Create task"
        },
        "rules": [
          {
            "key": "create",
            "labels": {
              "zh-CN": "创建待规划任务",
              "en": "Create backlog task"
            },
            "actors": [
              "coordinator"
            ],
            "to": "backlog",
            "writable_fields": [
              "title",
              "type",
              "priority",
              "role",
              "description",
              "context",
              "acceptance_criteria",
              "dependencies"
            ],
            "required_inputs": [
              "title"
            ],
            "defaults": {
              "priority": "P2"
            }
          }
        ]
      },
      "update": {
        "labels": {
          "zh-CN": "更新任务",
          "en": "Update task"
        },
        "rules": [
          {
            "key": "coordinate",
            "labels": {
              "zh-CN": "协调更新",
              "en": "Coordinator update"
            },
            "actors": [
              "coordinator"
            ],
            "from": [
              "backlog",
              "ready",
              "in_progress",
              "review"
            ],
            "writable_fields": [
              "title",
              "type",
              "priority",
              "description",
              "context",
              "acceptance_criteria",
              "dependencies",
              "progress",
              "next_action",
              "result_evidence"
            ]
          },
          {
            "key": "coordinate_blocked",
            "labels": {
              "zh-CN": "阻塞态协调更新",
              "en": "Blocked task coordinator update"
            },
            "actors": [
              "coordinator"
            ],
            "from": [
              "blocked"
            ],
            "writable_fields": [
              "title",
              "type",
              "priority",
              "description",
              "context",
              "acceptance_criteria",
              "dependencies",
              "progress",
              "next_action",
              "result_evidence",
              "blocked_reason",
              "waiting_on"
            ]
          },
          {
            "key": "execute",
            "labels": {
              "zh-CN": "执行更新",
              "en": "Executor update"
            },
            "actors": [
              "assigned_agent"
            ],
            "from": [
              "in_progress"
            ],
            "writable_fields": [
              "context",
              "progress",
              "next_action",
              "result_evidence"
            ]
          }
        ]
      },
      "route": {
        "labels": {
          "zh-CN": "路由任务",
          "en": "Route task"
        },
        "rules": [
        {
          "key": "prepare",
          "labels": {
            "zh-CN": "准备完成",
            "en": "Ready for execution"
            },
            "actors": [
              "coordinator"
            ],
            "from": [
              "backlog"
            ],
            "to": "ready",
            "writable_fields": [
              "role"
            ],
            "required_inputs": [
              "role"
            ],
            "clear_fields": [
              "agent",
              "agent_id",
              "blocked_reason",
            "waiting_on"
          ]
        },
        {
          "key": "delegate",
          "labels": {
            "zh-CN": "转交执行职责",
            "en": "Delegate for execution"
          },
          "actors": [
            "coordinator"
          ],
          "from": [
            "ready"
          ],
          "to": "ready",
          "writable_fields": [
            "role"
          ],
          "required_inputs": [
            "role"
          ],
          "clear_fields": [
            "agent",
            "agent_id",
            "blocked_reason",
            "waiting_on"
          ]
        },
        {
          "key": "resume",
          "labels": {
            "zh-CN": "解除阻塞",
            "en": "Resume after blocking"
            },
            "actors": [
              "coordinator"
            ],
            "from": [
              "blocked"
            ],
            "to": "ready",
            "writable_fields": [
              "role"
            ],
            "required_inputs": [
              "role"
            ],
            "clear_fields": [
              "agent",
              "agent_id",
              "blocked_reason",
              "waiting_on"
            ]
          },
          {
            "key": "recover",
            "labels": {
              "zh-CN": "恢复入队",
              "en": "Recover to ready"
            },
            "actors": [
              "coordinator"
            ],
            "from": [
              "in_progress"
            ],
            "to": "ready",
            "writable_fields": [
              "role"
            ],
            "required_inputs": [
              "role"
            ],
            "clear_fields": [
              "agent",
              "agent_id"
            ],
            "guards": [
              "execution_stopped"
            ]
          },
          {
            "key": "handoff",
            "labels": {
              "zh-CN": "评审后转交",
              "en": "Hand off after review"
            },
            "actors": [
              "coordinator"
            ],
            "from": [
              "review"
            ],
            "to": "ready",
            "writable_fields": [
              "role"
            ],
            "required_inputs": [
              "role"
            ],
            "clear_fields": [
              "agent",
              "agent_id"
            ]
          }
        ]
      },
      "claim": {
        "labels": {
          "zh-CN": "认领任务",
          "en": "Claim task"
        },
        "rules": [
          {
            "key": "claim",
            "labels": {
              "zh-CN": "认领执行",
              "en": "Claim for execution"
            },
            "actors": [
              "task_role"
            ],
            "from": [
              "ready"
            ],
            "to": "in_progress",
            "required_task_fields": [
              "type",
              "priority",
              "role",
              "description",
              "acceptance_criteria"
            ],
            "actor_fields": {
              "agent": "agent_name",
              "agent_id": "agent_id"
            }
          }
        ]
      },
      "submit": {
        "labels": {
          "zh-CN": "提交结果",
          "en": "Submit result"
        },
        "rules": [
          {
            "key": "completed",
            "labels": {
              "zh-CN": "工作已完成",
              "en": "Work completed"
            },
            "actors": [
              "assigned_agent"
            ],
            "roles": [
              "pm",
              "tl",
              "design"
            ],
            "from": [
              "in_progress"
            ],
            "to": "review",
            "writable_fields": [
              "progress",
              "next_action",
              "result_evidence"
            ],
            "required_inputs": [
              "result_evidence"
            ],
            "required_task_fields": [
              "result_evidence"
            ]
          },
          {
            "key": "passed",
            "labels": {
              "zh-CN": "验证通过",
              "en": "Validation passed"
            },
            "actors": [
              "assigned_agent"
            ],
            "roles": [
              "qa"
            ],
            "from": [
              "in_progress"
            ],
            "to": "review",
            "writable_fields": [
              "progress",
              "next_action",
              "result_evidence"
            ],
            "required_inputs": [
              "result_evidence"
            ],
            "required_task_fields": [
              "result_evidence"
            ],
            "field_prefixes": {
              "result_evidence": "QA 结论：通过（Passed）\n"
            }
          },
          {
            "key": "failed",
            "labels": {
              "zh-CN": "验证未通过",
              "en": "Validation failed"
            },
            "actors": [
              "assigned_agent"
            ],
            "roles": [
              "qa"
            ],
            "from": [
              "in_progress"
            ],
            "to": "review",
            "writable_fields": [
              "progress",
              "next_action",
              "result_evidence"
            ],
            "required_inputs": [
              "result_evidence"
            ],
            "required_task_fields": [
              "result_evidence"
            ],
            "field_prefixes": {
              "result_evidence": "QA 结论：未通过（Failed）\n"
            }
          }
        ]
      },
      "block": {
        "labels": {
          "zh-CN": "阻塞任务",
          "en": "Block task"
        },
        "rules": [
          {
            "key": "ready_executor",
            "labels": {
              "zh-CN": "执行前发现阻塞",
              "en": "Blocked before execution"
            },
            "actors": [
              "task_role"
            ],
            "roles": [
              "tl",
              "qa",
              "design"
            ],
            "from": [
              "ready"
            ],
            "to": "blocked",
            "writable_fields": [
              "progress",
              "next_action",
              "blocked_reason",
              "waiting_on"
            ],
            "required_inputs": [
              "next_action",
              "blocked_reason",
              "waiting_on"
            ],
            "field_values": {
              "waiting_on": [
                "pm"
              ]
            }
          },
          {
            "key": "ready_coordinator",
            "labels": {
              "zh-CN": "执行前等待项目决策",
              "en": "Await stakeholder before execution"
            },
            "actors": [
              "coordinator"
            ],
            "from": [
              "ready"
            ],
            "to": "blocked",
            "writable_fields": [
              "progress",
              "next_action",
              "blocked_reason",
              "waiting_on"
            ],
            "required_inputs": [
              "next_action",
              "blocked_reason",
              "waiting_on"
            ],
            "field_values": {
              "waiting_on": [
                "stakeholder"
              ]
            }
          },
          {
            "key": "executor",
            "labels": {
              "zh-CN": "执行中等待 PM",
              "en": "Executor waiting on PM"
            },
            "actors": [
              "assigned_agent"
            ],
            "roles": [
              "tl",
              "qa",
              "design"
            ],
            "from": [
              "in_progress"
            ],
            "to": "blocked",
            "writable_fields": [
              "progress",
              "next_action",
              "blocked_reason",
              "waiting_on"
            ],
            "required_inputs": [
              "next_action",
              "blocked_reason",
              "waiting_on"
            ],
            "field_values": {
              "waiting_on": [
                "pm"
              ]
            }
          },
          {
            "key": "coordinator",
            "labels": {
              "zh-CN": "等待项目决策人",
              "en": "Waiting on stakeholder"
            },
            "actors": [
              "coordinator"
            ],
            "roles": [
              "pm"
            ],
            "from": [
              "in_progress",
              "review"
            ],
            "to": "blocked",
            "writable_fields": [
              "progress",
              "next_action",
              "blocked_reason",
              "waiting_on"
            ],
            "required_inputs": [
              "next_action",
              "blocked_reason",
              "waiting_on"
            ],
            "field_values": {
              "waiting_on": [
                "stakeholder"
              ]
            }
          }
        ]
      },
      "review": {
        "labels": {
          "zh-CN": "评审任务",
          "en": "Review task"
        },
        "rules": [
          {
            "key": "approve",
            "labels": {
              "zh-CN": "验收通过",
              "en": "Approve"
            },
            "actors": [
              "coordinator"
            ],
            "from": [
              "review"
            ],
            "to": "done",
            "writable_fields": [
              "result_evidence"
            ],
            "required_inputs": [
              "result_evidence"
            ],
            "required_task_fields": [
              "result_evidence"
            ],
            "clear_fields": [
              "role",
              "agent",
              "agent_id",
              "progress",
              "next_action"
            ]
          },
          {
            "key": "rework",
            "labels": {
              "zh-CN": "打回返工",
              "en": "Return for rework"
            },
            "actors": [
              "coordinator"
            ],
            "from": [
              "review"
            ],
            "to": "ready",
            "writable_fields": [
              "role",
              "next_action",
              "result_evidence"
            ],
            "required_inputs": [
              "role",
              "result_evidence"
            ],
            "required_task_fields": [
              "result_evidence"
            ],
            "clear_fields": [
              "agent",
              "agent_id"
            ]
          },
          {
            "key": "send_to_qa",
            "labels": {
              "zh-CN": "转交 QA",
              "en": "Send to QA"
            },
            "actors": [
              "coordinator"
            ],
            "from": [
              "review"
            ],
            "to": "ready",
            "writable_fields": [
              "next_action",
              "result_evidence"
            ],
            "required_inputs": [
              "result_evidence"
            ],
            "required_task_fields": [
              "result_evidence"
            ],
            "fixed_fields": {
              "role": "qa"
            },
            "clear_fields": [
              "agent",
              "agent_id"
            ]
          }
        ]
      },
      "cancel": {
        "labels": {
          "zh-CN": "取消任务",
          "en": "Cancel task"
        },
        "confirmation_required": true,
        "rules": [
          {
            "key": "cancel",
            "labels": {
              "zh-CN": "确认取消",
              "en": "Confirm cancellation"
            },
            "actors": [
              "coordinator"
            ],
            "from": [
              "backlog",
              "ready",
              "review",
              "blocked"
            ],
            "to": "canceled",
            "writable_fields": [
              "result_evidence"
            ],
            "required_inputs": [
              "result_evidence"
            ],
            "required_task_fields": [
              "result_evidence"
            ],
            "clear_fields": [
