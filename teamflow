#!/bin/sh
ROOT=$(CDPATH= cd "$(dirname "$0")" && pwd)

if ! command -v uv >/dev/null 2>&1; then
  echo "teamflow: uv is required (https://docs.astral.sh/uv/)" >&2
  exit 1
fi

if [ -z "${LARK_CLI:-}" ]; then
  if command -v lark-cli >/dev/null 2>&1; then
    LARK_CLI=$(command -v lark-cli)
  else
    LARK_CLI="$ROOT/ui/node_modules/.bin/lark-cli"
  fi
  export LARK_CLI
fi

exec uv run --project "$ROOT" --locked python "$ROOT/scripts/teamflow.py" "$@"
