{
  "description": "Inject TeamFlow assignments once and restore them after compaction.",
  "hooks": {
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"${PLUGIN_ROOT}\" --locked python \"${PLUGIN_ROOT}/hooks/user_prompt_submit.py\"",
            "timeout": 60,
            "statusMessage": "Preparing TeamFlow context recovery"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"${PLUGIN_ROOT}\" --locked python \"${PLUGIN_ROOT}/hooks/user_prompt_submit.py\"",
            "timeout": 60,
            "statusMessage": "Loading TeamFlow assignment"
          }
        ]
      }
    ]
  }
}
